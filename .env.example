# vovchikGram local configuration
# Copy this file to .env and replace every CHANGE_ME value before first launch.
PORT=8787

# Set unique passwords before starting the server.
OWNER_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_OWNER_PASSWORD
DEV_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_DEV_PASSWORD

# Generate a private random value, at least 64 characters.
# PowerShell: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
JWT_SECRET=CHANGE_ME_TO_A_PRIVATE_RANDOM_SECRET
