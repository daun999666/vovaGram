{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vovchikGram",
  "version": "2.0.0",
  "identifier": "app.vovchikgram.desktop",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../../../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "vovchikGram",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "url": "http://127.0.0.1:8787"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8787 ws://127.0.0.1:8787; img-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:8787; media-src 'self' blob: http://127.0.0.1:8787"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/vovchikgram-server"]
  }
}
